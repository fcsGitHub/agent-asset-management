# 复制为 .env 并填入真实值。.env 不入库。
# 数据库（docker-compose 默认）
DATABASE_URL=postgres://taw_app:taw_app_dev@127.0.0.1:5437/taw
DATABASE_ADMIN_URL=postgres://taw_admin:taw_admin_dev@127.0.0.1:5437/taw

# 服务端口
API_PORT=4000
WEB_PORT=5175
SEMANTIC_WORKER_PORT=8100

# Blob 存储（本地内容寻址库根目录）
BLOBSTORE_ROOT=./data/blobs

# LLM（DeepSeek 官方 API，OpenAI 兼容协议）
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 会话签名密钥（开发用；生产必须更换）
SESSION_SECRET=dev-only-change-me
