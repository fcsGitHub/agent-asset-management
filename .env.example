# 复制为 .env 并填入真实值。.env 不入库。
# 数据库（docker-compose 默认）
DATABASE_URL=postgres://taw_app:taw_app_dev@127.0.0.1:5437/taw
DATABASE_ADMIN_URL=postgres://taw_admin:taw_admin_dev@127.0.0.1:5437/taw

# 服务端口
API_PORT=4000
WEB_PORT=5175
SEMANTIC_WORKER_PORT=8100

# Blob 存储（本地内容寻址库根目录）
BLOBSTORE_ROOT=./data/blobs

# LLM（DeepSeek 官方 API，OpenAI 兼容协议）
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 会话签名密钥（开发用；生产必须更换）
SESSION_SECRET=dev-only-change-me

# outbox 派发 worker（npm run dev:worker）
OUTBOX_DISPATCH_URL=            # 事件接收端（HTTP POST）；留空则 worker 空转
OUTBOX_DATABASE_URL=postgres://taw_worker:taw_worker_dev@127.0.0.1:5437/taw
OUTBOX_POLL_MS=2000
OUTBOX_BATCH=20

# 图数据库（M49 本体检索投影库；docker compose up -d graphdb）
# 未启动时系统诚实降级：闭包检索回落 SQL，图谱多跳邻域/路径端点返回 503。
GRAPHDB_URL=bolt://127.0.0.1:7687
GRAPH_RECONCILE_MS=5000         # worker 图投影对账周期

